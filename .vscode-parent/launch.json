{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug viewer server (port 7343)",
            "preLaunchTask": "build:webapp",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/RevEng/src/viewer_server.ts",
            // "args": ["--port", "7343", "--projects-dir", "scenarios/executed"],
            "args":["--port", "7343", "--projects-dir", "/Users/matkatmusicllc/Programming/jot-recovery/claude-data/projects", "--resetSandboxMemo"],
            // "args":["--port", "7343", "--projects-dir", "/Users/matkatmusicllc/Programming/jot-recovery/claude-data/projects"],
            "cwd": "${workspaceFolder}/RevEng",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Open JSONL Tree Viewer",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/RevEng/jsonl-tree-viewer.html"
        }
    ]
}
