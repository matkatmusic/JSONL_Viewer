{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug viewer server (port 7343)",
            "preLaunchTask": "build:webapp",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/RevEng/jfred/src/viewer_server.ts",
            // "args": ["--port", "7343", "--projects-dir", "${workspaceFolder}/RevEng/jfred/scenarios/executed"],
            "args": ["--port", "7343", "--projects-dir", "${workspaceFolder}/RevEng/jfred/scenarios/executed", "--resetSandboxMemo"],
            // "args":["--port", "7343", "--projects-dir", "/Users/matkatmusicllc/Programming/jot-recovery/claude-data/projects", "--resetSandboxMemo"],
            // "args":["--port", "7343", "--projects-dir", "/Users/matkatmusicllc/Programming/jot-recovery/claude-data/projects"],
            "cwd": "${workspaceFolder}/RevEng/jfred",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug viewer server (failure fixture)",
            "preLaunchTask": "prep:demo-corrupt",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/RevEng/jfred/src/viewer_server.ts",
            "args": ["--port", "7343", "--projects-dir", "${workspaceFolder}/RevEng/jfred/demo-corrupt/projects", "--file-history-dir", "${workspaceFolder}/RevEng/jfred/demo-corrupt/file-history", "--resetDocumentCache"],
            "cwd": "${workspaceFolder}/RevEng/jfred",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug viewer server (pre-baseline demo)",
            "preLaunchTask": "prep:demo-baseline",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/RevEng/jfred/src/viewer_server.ts",
            "args": ["--port", "7343", "--projects-dir", "${workspaceFolder}/RevEng/jfred/demo-baseline/projects", "--file-history-dir", "${workspaceFolder}/RevEng/jfred/demo-baseline/file-history", "--resetDocumentCache"],
            "cwd": "${workspaceFolder}/RevEng/jfred",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Open JSONL Tree Viewer",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/RevEng/archive/jfred/jfred.html"
        }
    ]
}
