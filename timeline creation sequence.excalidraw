    {
      "id": "E_4Kba3W6vYel_s5BieT1",
      "type": "text",
      "x": 180.2260571290683,
      "y": 1924.3867588531443,
      "width": 1539.9976806640625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
