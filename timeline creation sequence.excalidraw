      "roundness": null,
      "seed": 153910733,
      "version": 211,
      "versionNonce": 934939565,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1784837969016,
      "link": null,
      "locked": false,
      "text": "Every diff between the starting point and the current on-disk state is classified as a User Edit until we eliminate all unknown states between JSONL events",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every diff between the starting point and the current on-disk state is classified as a User Edit until we eliminate all unknown states between JSONL events",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XcbPJXWD4NWs2wo7w5IqO",
      "type": "text",
      "x": 303.39393615722656,
      "y": 236.5084057482136,
      "width": 1223.198486328125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 482526317,
      "version": 362,
      "versionNonce": 2050883555,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784842931906,
      "link": null,
      "locked": false,
      "text": "Every diff between points on the timeline is classified as a User Edit, shown as a dashed (-----) line, unless confirmed as something else.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every diff between points on the timeline is classified as a User Edit, shown as a dashed (-----) line, unless confirmed as something else.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8uj3N20j_C8z92pa-POWi",
      "type": "text",
      "x": 489.79105478309725,
      "y": 403.65266638450873,
      "width": 906.3987426757812,
      "height": 40,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 2007263949,
      "version": 468,
      "versionNonce": 71356707,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784843002302,
      "link": null,
      "locked": false,
      "text": "Every confirmed-correct event type is inserted as a beacon in the timeline\nCommits are inserted first, then File History snapshots, then the remaining JSONL events are processed.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every confirmed-correct event type is inserted as a beacon in the timeline\nCommits are inserted first, then File History snapshots, then the remaining JSONL events are processed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HwRdkWxFm7SCHkKMe3Y0A",
      "type": "text",
      "x": 449.3663889567058,
      "y": 1039.414981269047,
      "width": 985.5986328125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 1832867981,
      "version": 751,
      "versionNonce": 1456959683,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784840278063,
      "link": null,
      "locked": false,
      "text": "Diffs that are explained by a pair of timeline events get reclassified as that event type, shown as a solid line\nAll other unexplained diffs are classified as User Edits.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Diffs that are explained by a pair of timeline events get reclassified as that event type, shown as a solid line\nAll other unexplained diffs are classified as User Edits.",
      "autoResize": true,
      "lineHeight": 1.25
    },
