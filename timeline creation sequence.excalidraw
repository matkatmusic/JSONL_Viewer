      "versionNonce": 927167779,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784840315307,
      "link": null,
      "locked": false,
      "text": "Diffs that are explained by a pair of timeline events get reclassified as that event type.\nThey are shown as a solid line, and the User Edit between them is removed.\nAll other unexplained diffs are still classified as User Edits.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Diffs that are explained by a pair of timeline events get reclassified as that event type.\nThey are shown as a solid line, and the User Edit between them is removed.\nAll other unexplained diffs are still classified as User Edits.",
      "autoResize": true,
      "lineHeight": 1.25
    },
