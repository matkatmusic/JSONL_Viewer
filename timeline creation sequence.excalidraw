    {
      "id": "E_4Kba3W6vYel_s5BieT1",
      "type": "text",
      "x": 180.2260571290683,
      "y": 1924.3867588531443,
      "width": 1539.9976806640625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2M",
      "roundness": null,
      "seed": 1968043693,
      "version": 2495,
      "versionNonce": 201684867,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784841900026,
      "link": null,
      "locked": false,
      "text": "If two points that surround a script execution point on the timeline are confirmed Not-User-Edit types, \nthe script at the script execution point can be executed.\n\nIf the post-execution state matches the point after the script execution point, then the gap between the pre-execution and post-execution can be reclassified as Not-User-Edit.\nIf the post-execution state results in a diff with the post-execution beacon, then the diff is confirmed as a an unconfirmed user edit.\n\nIf there are no other Modifying event types between the script execution and the post-execution becon, the User Edit is confirmed.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If two points that surround a script execution point on the timeline are confirmed Not-User-Edit types, \nthe script at the script execution point can be executed.\n\nIf the post-execution state matches the point after the script execution point, then the gap between the pre-execution and post-execution can be reclassified as Not-User-Edit.\nIf the post-execution state results in a diff with the post-execution beacon, then the diff is confirmed as a an unconfirmed user edit.\n\nIf there are no other Modifying event types between the script execution and the post-execution becon, the User Edit is confirmed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
