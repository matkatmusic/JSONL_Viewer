      "updated": 1784841655619,
      "link": null,
      "locked": false,
      "text": "Diffs that are explained by a branch event get reclassified as that event type, including rewound/unrewound code changes\nThey are shown as a solid line, and the User Edit between them is removed.\nAll other unexplained diffs are still classified as User Edits.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Diffs that are explained by a branch event get reclassified as that event type, including rewound/unrewound code changes\nThey are shown as a solid line, and the User Edit between them is removed.\nAll other unexplained diffs are still classified as User Edits.",
      "autoResize": true,
      "lineHeight": 1.25
    },
