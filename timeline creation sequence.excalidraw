      "type": "text",
      "x": 84.14057922363281,
      "y": 378.3003979357136,
      "width": 1363.9981689453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
