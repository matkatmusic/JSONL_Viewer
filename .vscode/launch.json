{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug node:test (current file)",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx", "--test"],
            "program": "${file}",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug viewer server (port 7343)",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${workspaceFolder}/src/viewer_server.ts",
            "args": ["--port", "7343", "--projects-dir", "plans/scenarios/executed"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug TS file (current file)",
            "runtimeExecutable": "node",
            "runtimeArgs": ["--import", "tsx"],
            "program": "${file}",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "smartStep": true,
            "console": "integratedTerminal"
        }
    ]
}
